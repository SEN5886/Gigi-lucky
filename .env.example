# 复制为 .env.local 后填写。密钥只留在服务端。
# 不要使用 NEXT_PUBLIC_ 前缀，也不要把真实密钥提交到仓库。

# 小久合作方 API Key，请求头为 Authorization: Bearer <key>
XIAOJIU_API_KEY=

# 可选。默认指向合作方 v1
XIAOJIU_API_BASE_URL=https://982xj.xyz/api/partner/v1/xiaojiu

# 可选。卡密与订单号的本地档案，仅保存对应关系，不保存登录会话
ORDER_STORE_PATH=.data/cdk-orders.json

# mock：结算在本地完成，不会真实扣款。live：支付接口返回尚未接入
PAYMENT_MODE=mock

# stub：验证码接口不发码。mock 或非生产环境的 dev：本地生成验证码，不调用云。
# otp：已选中正式通道，但发送器仍是未接通的接口，不会请求阿里云或腾讯云。
AUTH_MODE=stub

# 可选。至少 16 位。用于验证码哈希。不设置时会在 .data/otp-pepper 生成一次。
OTP_PEPPER=

# 以下为将来接通短信和邮件时使用，现在的代码不会读取它们去发信。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM=
TENCENT_SES_TEMPLATE_ID=

# 后台口令。至少 8 位。不配置时 /admin 无法登录。
ADMIN_TOKEN=

# 可选。可编辑商品目录与页面文案，进程重启后仍在。
CATALOG_DATA_PATH=.data/catalog.json
CONTENT_DATA_PATH=.data/content.json

# 可选。商城会话、购物车和订单档案
MALL_DATA_PATH=.data/mall.json

# 可选。至少 16 位。不配置时，支付回调一律拒绝
PAYMENT_WEBHOOK_SECRET=

# 可选。仅在 HTTPS 反向代理后设为 true
COOKIE_SECURE=false
